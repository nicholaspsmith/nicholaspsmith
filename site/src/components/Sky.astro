---
import { STOPS } from '../lib/sky';
---
<div class="sky" aria-hidden="true">
  {STOPS.map((s) => (
    <div class="sky__layer" data-stop-layer={s.id} style={`background:linear-gradient(${s.top},${s.bottom})`}></div>
  ))}
  <div class="sky__stars"></div>
  <div class="sky__orbit"><div class="sky__orb"></div></div>
  <div class="sky__palm"></div>
  <svg class="sky__marsh" viewBox="0 0 1440 200" preserveAspectRatio="none">
    <path fill="currentColor" d="M0 120C160 90 300 140 480 118S820 86 980 112s300 26 460-4V200H0Z" />
  </svg>
</div>
<div class="chip needs-js">
  <span data-clock></span>
  <button type="button" data-sky-toggle aria-pressed="true" aria-label="Moving background">
    <svg class="chip__on" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path fill="currentColor" d="M2 1h3v10H2zM7 1h3v10H7z" /></svg>
    <svg class="chip__off" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path fill="currentColor" d="M2.5 1l8 5-8 5z" /></svg>
  </button>
</div>

<script>
  import { STOPS, formatClock, progressAt, skyAt } from '../lib/sky';

  const root = document.documentElement;
  const KEY = 'moving-background-off';
  const BLEND = 0.35; // Crossfade over this share of the screen, either side of an edge.

  function remember(off: boolean) {
    try {
      localStorage.setItem(KEY, off ? '1' : '0');
    } catch {
      // Storage can be blocked. The choice then lasts for this visit only.
    }
  }

  function recall(): boolean {
    try {
      return localStorage.getItem(KEY) === '1';
    } catch {
      return false;
    }
  }

  function start() {
    const sections = [...document.querySelectorAll<HTMLElement>('[data-stop]')];
    const layers = STOPS.map((s) => document.querySelector<HTMLElement>(`[data-stop-layer="${s.id}"]`)!);
    const stars = document.querySelector<HTMLElement>('.sky__stars')!;
    const orb = document.querySelector<HTMLElement>('.sky__orb')!;
    const clock = document.querySelector<HTMLElement>('[data-clock]')!;
    const marsh = document.querySelector<HTMLElement>('.sky__marsh')!;
    const palm = document.querySelector<HTMLElement>('.sky__palm')!;
    const toggle = document.querySelector<HTMLButtonElement>('[data-sky-toggle]')!;

    let edges: number[] = [];
    const navOffset = parseFloat(getComputedStyle(root).scrollPaddingTop) || 0;
    let queued = false;

    const measure = () => {
      edges = sections.slice(1).map((el) => el.getBoundingClientRect().top + scrollY);
    };

    const paint = () => {
      queued = false;
      // Anchors stop below the nav, so look that far past the middle of the screen.
      const p = progressAt(scrollY + innerHeight / 2 + navOffset, edges, innerHeight * BLEND);
      const s = skyAt(p);
      layers.forEach((layer, i) => {
        layer.style.opacity = i === s.index ? '1' : i === s.index + 1 ? String(s.t) : '0';
      });
      root.style.setProperty('--ink', s.ink);
      root.style.setProperty('--land', s.land);
      const alpha = Math.round(s.veil * 255).toString(16).padStart(2, '0');
      root.style.setProperty('--veil', s.veil > 0 ? `${s.inverse}${alpha}` : 'transparent');
      stars.style.opacity = String(s.night);
      marsh.style.color = s.land;
      palm.style.backgroundColor = s.land;
      clock.textContent = `${formatClock(s.minutes)} in Charleston`;
      root.dataset.sky = STOPS[Math.round(p)].id;

      // The sun climbs and sets by sunset. The moon follows it up after dusk.
      const SUNSET = 5.2;
      const MOONRISE = 5.6;
      const moon = p > MOONRISE;
      const q = moon ? (p - MOONRISE) / (8 - MOONRISE) : Math.min(1, p / SUNSET);
      const x = 54 + q * (moon ? 26 : 40);
      const y = 90 - Math.sin(q * Math.PI * (moon ? 0.5 : 1)) * 76;
      orb.style.transform = `translate(calc(${x}vw - 50%), calc(${y}vh - 50%))`;
      orb.classList.toggle('sky__orb--moon', moon);
      orb.style.opacity = !moon && p > SUNSET ? '0' : '1';
    };

    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(paint);
      }
    };

    const refresh = () => {
      measure();
      queue();
    };

    // Off, the page falls back to each section's own still sky, the same one
    // readers get with reduced motion or without JavaScript.
    const setLive = (live: boolean) => {
      root.classList.toggle('sky-live', live);
      toggle.setAttribute('aria-pressed', String(live));
    };

    toggle.addEventListener('click', () => {
      const live = toggle.getAttribute('aria-pressed') !== 'true';
      setLive(live);
      remember(!live);
    });
    setLive(!recall());

    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', refresh);
    addEventListener('hashchange', refresh);
    new ResizeObserver(refresh).observe(document.body);

    measure();
    paint();
  }

  if (root.classList.contains('sky-capable')) start();
</script>

<style>
  .sky { display: none; }
  :global(.sky-live) .sky { display: block; position: fixed; inset: 0; z-index: 0; overflow: hidden; contain: strict; background: #8ea3cf; }
  .sky__layer { position: absolute; inset: 0; opacity: 0; will-change: opacity; }
  .sky__stars {
    position: absolute;
    inset: 0;
    opacity: 0;
    background-image:
      radial-gradient(1.4px 1.4px at 12% 18%, #fff, transparent),
      radial-gradient(1.2px 1.2px at 31% 9%, #fff, transparent),
      radial-gradient(1.6px 1.6px at 48% 26%, #fff, transparent),
      radial-gradient(1.1px 1.1px at 64% 12%, #fff, transparent),
      radial-gradient(1.5px 1.5px at 79% 30%, #fff, transparent),
      radial-gradient(1.2px 1.2px at 90% 8%, #fff, transparent),
      radial-gradient(1.3px 1.3px at 22% 40%, #fff, transparent),
      radial-gradient(1.1px 1.1px at 56% 44%, #fff, transparent),
      radial-gradient(1.2px 1.2px at 70% 52%, #fff, transparent),
      radial-gradient(1.4px 1.4px at 38% 58%, #fff, transparent);
  }
  .sky__orbit { position: absolute; inset: 0; }
  .sky__orb {
    position: absolute;
    left: 0;
    top: 0;
    width: clamp(4.5rem, 12vmin, 8rem);
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate(calc(54vw - 50%), calc(90vh - 50%));
    will-change: transform;
    background: #fff3c9;
    box-shadow: 0 0 5rem 1.75rem #ffd99a88;
    transition: opacity 400ms;
  }
  .sky__orb--moon { background: #eef2ff; box-shadow: 0 0 4rem 1rem #cfd8ff33; }
  .sky__palm {
    position: absolute;
    right: 2vw;
    bottom: 6vh;
    width: min(38vw, 32rem);
    height: min(80vh, 36.25rem);
    background: #2c4a48;
    mask: url(/musictree.svg) right bottom / contain no-repeat;
    transform-origin: 72% 100%;
    animation: sway 7s ease-in-out infinite alternate;
    will-change: transform;
  }
  .sky__marsh { position: absolute; left: 0; bottom: 0; width: 100%; height: 20vh; color: #2c4a48; }
  @keyframes sway {
    from { transform: rotate(-0.8deg) skewX(0.4deg); }
    to { transform: rotate(1deg) skewX(-0.5deg); }
  }
  .chip {
    display: none;
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 25;
    align-items: center;
    gap: 0.6rem;
    padding: 0.25rem 0.35rem 0.25rem 0.8rem;
    border-radius: 99rem;
    background: #0e1f28d9;
    color: #fff;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  :global(.sky-capable) .chip { display: flex; }
  .chip button { display: grid; place-items: center; width: 1.75rem; height: 1.75rem; border-radius: 50%; }
  .chip button:hover { background: #ffffff26; }
  .chip__off { display: none; }
  .chip button[aria-pressed='false'] .chip__on { display: none; }
  .chip button[aria-pressed='false'] .chip__off { display: block; }
  @media (max-width: 56rem) {
    .sky__orbit { opacity: 0.3; }
    .sky__palm { opacity: 0.35; }
  }
</style>

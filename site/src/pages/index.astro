---
import Base from '../layouts/Base.astro';
import ContactLinks from '../components/ContactLinks.astro';
import DaySection from '../components/DaySection.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import Sky from '../components/Sky.astro';
import { PROJECTS } from '../data/projects';
import { RESUME } from '../data/resume';
import DayNightHouse from '../interactive/DayNightHouse.astro';
import DoseCalendar from '../interactive/DoseCalendar.astro';
import FabricPicker from '../interactive/FabricPicker.astro';
import HazardLayers from '../interactive/HazardLayers.astro';
import MenumonBar from '../interactive/MenumonBar.astro';
import RecipeScaler from '../interactive/RecipeScaler.astro';
import SubtitleWords from '../interactive/SubtitleWords.astro';

const EXPERIENCE = RESUME.jobs.filter((job) => 'highlight' in job && job.highlight);

const PERSON = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Nicholas P Smith',
  url: 'https://nicholaspsmith.com/',
  email: 'mailto:me@nicksmith.software',
  jobTitle: 'Senior Software Engineer',
  image: 'https://nicholaspsmith.com/og.png',
  address: { '@type': 'PostalAddress', addressLocality: 'Charleston', addressRegion: 'SC', addressCountry: 'US' },
  sameAs: ['https://www.linkedin.com/in/nps90/', 'https://github.com/nicholaspsmith', 'https://nicksmith.software'],
};

const TRY: Record<string, any> = {
  'powells-upholstery': FabricPicker,
  'chs-irrigation-lighting': DayNightHouse,
  'disaster-maps': HazardLayers,
  'from-tired-to-iron': RecipeScaler,
  zimu: SubtitleWords,
  petdoses: DoseCalendar,
};

---
<Base
  title="Nicholas P Smith | Software engineer and designer"
  description="I design and build software people enjoy using. Senior software engineer in Charleston, SC, with experience at MongoDB and Cisco."
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(PERSON)} />
  <Nav />
  <Sky />
  <main id="main">
    <DaySection stop="dawn" id="about" level={1} heading="I design and build software people enjoy using." palm>
      <p>
        I'm Nicholas P Smith, a senior software engineer in Charleston, SC. I've built products at MongoDB and
        Cisco, and I design everything before I build it. Scroll through a day of my work.
      </p>
    </DaySection>
    <div id="work">
      {PROJECTS.map((project) => {
        const Try = TRY[project.slug];
        return (
          <DaySection stop={project.stop} id={project.slug} heading={project.name}>
            <p class="one-line">{project.oneLine}</p>
            <p class="more"><a class="link-arrow" href={`/work/${project.slug}`}>The full story</a></p>
            {Try && <Try slot="try" />}
          </DaySection>
        );
      })}
      <DaySection stop="night" id="menumon" heading="Menumon" wide>
        <p class="one-line">Ten small Mac apps, each with its own character. This is a working copy of the menu bar. Click an icon and try one.</p>
        <MenumonBar slot="try" />
      </DaySection>
    </div>
    <DaySection stop="late" id="contact" heading="Still up? Let's talk.">
      <p>Whether you're hiring or need something built through Bright Logic Digital, I'd like to hear about it.</p>
      <ContactLinks />
      <div slot="try" class="experience">
        <h3>Where I've worked</h3>
        <ul data-experience>
          {EXPERIENCE.map((job) => (
            <li><b>{job.company}</b><span>{job.title}</span><span class="dates">{job.dates}</span></li>
          ))}
        </ul>
        <p><a class="link-arrow" href="/resume">Full resume</a></p>
      </div>
    </DaySection>
  </main>
  <Footer />
</Base>

<style>
  .one-line { font-size: 1.3rem; line-height: 1.4; }
  .more { margin-top: 1rem; }
  .experience { max-width: 34rem; margin-left: auto; }
  .experience h3 { font-size: 1.5rem; margin-bottom: 0.75rem; }
  .experience ul { list-style: none; margin: 0 0 1rem; padding: 0; }
  .experience li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0 1rem; padding: 0.6rem 0; border-top: 1px solid #ffffff33; }
  .experience li span:not(.dates) { grid-row: 2; }
  .experience .dates { font-size: 0.95rem; color: #d5dbe8; font-variant-numeric: tabular-nums; }
</style>

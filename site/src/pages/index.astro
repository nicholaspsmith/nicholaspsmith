---
import Base from '../layouts/Base.astro';
import ContactLinks from '../components/ContactLinks.astro';
import DaySection from '../components/DaySection.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import Sky from '../components/Sky.astro';

const WORK = [
  ['early', 'powells-upholstery', "Powell's Upholstery"],
  ['morning', 'chs-irrigation-lighting', 'CHS Irrigation & Lighting'],
  ['midday', 'disaster-maps', 'DisasterMaps'],
  ['afternoon', 'from-tired-to-iron', 'From Tired to Iron'],
  ['sunset', 'zimu', 'Zimu'],
  ['dusk', 'petdoses', 'PetDoses'],
  ['night', 'menumon', 'Menumon'],
] as const;
---
<Base
  title="Nicholas P Smith | Software engineer and designer"
  description="I design and build software people enjoy using. Senior software engineer in Charleston, SC, with experience at MongoDB and Cisco."
>
  <Nav />
  <Sky />
  <main id="main">
    <DaySection stop="dawn" id="about" level={1} heading="I design and build software people enjoy using." palm>
      <p>
        I'm Nicholas P Smith, a senior software engineer in Charleston, SC. I've built products at MongoDB and
        Cisco, and I design everything before I build it. Scroll through a day of my work.
      </p>
    </DaySection>
    <div id="work">
      {WORK.map(([stop, id, name]) => <DaySection stop={stop} id={id} heading={name} />)}
    </div>
    <DaySection stop="late" id="contact" heading="Still up? Let's talk." palm>
      <p>Whether you're hiring or need something built through Bright Logic Digital, I'd like to hear about it.</p>
      <ContactLinks />
    </DaySection>
  </main>
  <Footer />
</Base>

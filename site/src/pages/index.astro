---
import Base from '../layouts/Base.astro';
import ContactLinks from '../components/ContactLinks.astro';
import DaySection from '../components/DaySection.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import Sky from '../components/Sky.astro';
import { PROJECTS } from '../data/projects';
import FabricPicker from '../interactive/FabricPicker.astro';
import RecipeScaler from '../interactive/RecipeScaler.astro';
import SubtitleWords from '../interactive/SubtitleWords.astro';

const TRY: Record<string, any> = {
  'powells-upholstery': FabricPicker,
  'from-tired-to-iron': RecipeScaler,
  zimu: SubtitleWords,
};

---
<Base
  title="Nicholas P Smith | Software engineer and designer"
  description="I design and build software people enjoy using. Senior software engineer in Charleston, SC, with experience at MongoDB and Cisco."
>
  <Nav />
  <Sky />
  <main id="main">
    <DaySection stop="dawn" id="about" level={1} heading="I design and build software people enjoy using." palm>
      <p>
        I'm Nicholas P Smith, a senior software engineer in Charleston, SC. I've built products at MongoDB and
        Cisco, and I design everything before I build it. Scroll through a day of my work.
      </p>
    </DaySection>
    <div id="work">
      {PROJECTS.map((project) => {
        const Try = TRY[project.slug];
        return (
          <DaySection stop={project.stop} id={project.slug} heading={project.name}>
            <p class="one-line">{project.oneLine}</p>
            <p class="more"><a class="link-arrow" href={`/work/${project.slug}`}>The full story</a></p>
            {Try && <Try slot="try" />}
          </DaySection>
        );
      })}
      <DaySection stop="night" id="menumon" heading="Menumon">
        <p class="one-line">A family of small Mac apps, each with its own character.</p>
      </DaySection>
    </div>
    <DaySection stop="late" id="contact" heading="Still up? Let's talk." palm>
      <p>Whether you're hiring or need something built through Bright Logic Digital, I'd like to hear about it.</p>
      <ContactLinks />
    </DaySection>
  </main>
  <Footer />
</Base>

<style>
  .one-line { font-size: 1.3rem; line-height: 1.4; }
  .more { margin-top: 1rem; }
</style>

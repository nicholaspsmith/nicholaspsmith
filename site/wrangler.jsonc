{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nicholaspsmith-com",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
  // Custom domain routes are added at launch: see the launch checklist.
}
